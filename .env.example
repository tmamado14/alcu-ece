DATABASE_URL="file:./dev.db"
SESSION_SECRET="change-me-to-any-random-string"
# Optional: enables background generation of worked solutions for problems
# that don't have one. Get a key at https://platform.deepseek.com — put the
# real key ONLY in .env (gitignored), never commit it.
DEEPSEEK_API_KEY=""
# Optional override; defaults to deepseek-v4-flash (fast). Use
# deepseek-v4-pro for higher quality at higher cost/latency.
# DEEPSEEK_MODEL="deepseek-v4-pro"
