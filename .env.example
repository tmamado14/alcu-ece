# --- Database (Neon Postgres) ---
# Both come from the Neon dashboard -> your branch -> "Connect".
# DATABASE_URL is the POOLED string (its host contains "-pooler"): used by the
#   app at runtime, so serverless functions don't exhaust connection slots.
# DIRECT_URL is the UNPOOLED string: used by `prisma migrate`, which needs a
#   session-level connection a pooler cannot provide.
# Locally, point these at a Neon *dev* branch so experiments never touch the
# data your colleagues are using.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# --- Sessions ---
# Signs the session cookie. MUST be set to a random string of at least 32
# characters in production — the app refuses to start otherwise, because a
# guessable secret lets anyone forge an admin session.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-any-random-string"

# --- Optional: AI worked-solution generation ---
# Enables background generation of worked solutions for problems that don't
# have one. Get a key at https://platform.deepseek.com — put the real key ONLY
# in .env (gitignored), never commit it.
DEEPSEEK_API_KEY=""
# Optional override; defaults to deepseek-v4-flash (fast). Use
# deepseek-v4-pro for higher quality at higher cost/latency.
# DEEPSEEK_MODEL="deepseek-v4-pro"
